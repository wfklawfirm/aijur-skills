# ---- Database -------------------------------------------------------------
# Local dev (default): a file-backed libSQL/SQLite database, no server needed.
DATABASE_URL="file:./data/aijur.db"
# Hosted libSQL (Turso) — same client, swap the URL and add a token:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN=""

# ---- Session signing ------------------------------------------------------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-value"

# ---- AI providers (all optional) -----------------------------------------
# With no key set the app runs on the deterministic offline provider, so every
# simulation / evaluation screen still works end to end.
AI_PRIMARY_PROVIDER="offline"   # offline | anthropic | openai
AI_FALLBACK_PROVIDER="offline"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Speech (optional; UI degrades to text-only when unset)
SPEECH_PROVIDER="browser"       # browser | openai

# ---- Email (optional) ------------------------------------------------------
# With no provider configured, password-reset emails are logged to the server
# console instead of delivered — fine for local dev, not for production. Set
# EMAIL_PROVIDER=resend and RESEND_API_KEY to send real email.
EMAIL_PROVIDER="console"        # console | resend
RESEND_API_KEY=""
EMAIL_FROM="AIJUR <no-reply@aijur.app>"
# Absolute origin used to build reset links (e.g. "https://app.aijur.ai").
# Falls back to reading the request's Host header when unset.
APP_URL=""

# ---- Mobile app (Capacitor) -------------------------------------------------
# Required for `npx cap sync` to point the native shell at your real,
# healthy production deployment -- never hardcoded, never guessed. Unset
# fails loud (a console.warn) rather than silently pointing at nothing.
# Confirmed real production domain as of item #62 (see .scratch/status.md):
# https://aijur-skills-mu.vercel.app -- a default Vercel-assigned domain,
# not a custom one. If a custom domain is ever added, update this and
# every REPLACE_WITH_PRODUCTION_DOMAIN placeholder in the Android/iOS deep
# link config together (docs/MOBILE_DEEP_LINKS.md).
MOBILE_APP_SERVER_URL="https://aijur-skills-mu.vercel.app"
# Dev/LAN-testing only -- allows http:// instead of https://. Never true in
# a production build.
MOBILE_APP_ALLOW_CLEARTEXT="false"

# ---- Push notifications (optional; registration works without these, but
# nothing is actually sent until real credentials exist) -------------------
FIREBASE_PROJECT_ID=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
