<?xml version="1.0" encoding="utf-8"?>
<!--
  AIJUR brand colors for the Android chrome (status bar tinting, default
  Material theme accents). Deliberately does NOT redeclare
  ic_launcher_background, since that name already exists in this same
  values directory (values/ic_launcher_background.xml, generated by
  capacitor-assets), and AAPT rejects duplicate resource names even across
  two different files. This comment itself avoids using a literal double
  hyphen anywhere, since XML comments cannot contain that character
  sequence at all.
-->
<resources>
    <color name="colorPrimary">#7a1832</color>
    <color name="colorPrimaryDark">#5c1226</color>
    <color name="colorAccent">#7a1832</color>
</resources>
